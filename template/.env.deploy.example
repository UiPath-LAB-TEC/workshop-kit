# Copy this file to .env.deploy.<target>, for example .env.deploy.growth.
# Deployment env files are local-only and ignored by git.

# Required for non-interactive UiPath Coded App deployment.
# Resolve it with: uip or folders list --output json
UIPATH_FOLDER_KEY=00000000-0000-0000-0000-000000000000

# Optional. If omitted, scripts generate a timestamp version.
UIPATH_CODEDAPP_VERSION=0.1.0

# Optional pack metadata.
UIPATH_CODEDAPP_AUTHOR=UiPath LAB TEC

# Optional local dashboard defaults. Use ISO 8601 timestamps.
WORKSHOP_TARGET=internal-field-20260722
WORKSHOP_START=2026-07-22T17:00:00Z
WORKSHOP_END=2026-07-22T22:00:00Z

# Optional if the inferred UiPath_<org>_<tenant> Re:infer context is not correct.
RE_CONTEXT=UiPath_uipathlabstraining_Internal_Field_Coding_A_20260722
